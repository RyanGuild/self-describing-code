sequenceDiagram
    autonumber
    participant pad as pad()
    participant UnicodeWidthStr__width as UnicodeWidthStr::width
    participant to_owned as to_owned
    participant String__with_capacity as String::with_capacity
    participant push_str as push_str
    participant push as push
    pad-->>UnicodeWidthStr__width: UnicodeWidthStr::width(text)
    alt actual >= width
    pad-->>to_owned: text.to_owned()
    pad-->>pad: return
    end
    pad-->>String__with_capacity: String::with_capacity(text.len() + width - actual)
    pad-->>push_str: out.push_str(text)
    loop actual..width
    pad-->>push: out.push(' ')
    end
    pad-->>pad: out
