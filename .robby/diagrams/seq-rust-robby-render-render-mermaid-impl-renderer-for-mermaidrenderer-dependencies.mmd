sequenceDiagram
    autonumber
    participant dependencies as dependencies()
    participant String__from as String::from
    participant emit_container as emit_container
    dependencies-->>String__from: String::from('flowchart TD\n')
    alt view.is_empty()
    dependencies-->>dependencies: out
    dependencies-->>dependencies: return
    end
    loop &view.roots
    dependencies-->>emit_container: emit_container(&mut out, root, 1)
    end
    loop &view.externals
    dependencies-->>dependencies: writeln!( out, ' {}([\'{}\'])', external.stable_id, external.label )
    end
    loop &view.edges
    alt edge.resolved
    dependencies-->>dependencies: '-->'
    else else
    dependencies-->>dependencies: '-.->'
    end
    dependencies-->>dependencies: writeln!( out, ' {} {arrow}|{}| {}', edge.from, edge.label, edge.to )
    end
    dependencies-->>dependencies: out
