sequenceDiagram
    autonumber
    participant emit_class as emit_class()
    participant class_id as class_id
    participant push_str as push_str
    participant get as get
    emit_class-->>class_id: class_id(&node.name)
    alt !emitted.insert(id.clone())
    emit_class-->>emit_class: return
    end
    emit_class-->>emit_class: writeln!(out, ' class {id} {{')
    alt match node.kind.as_str()
    emit_class-->>push_str: out.push_str(' <<interface>>\n')
    else kind::code::ENUM
    emit_class-->>push_str: out.push_str(' <<enumeration>>\n')
    else 
    loop &node.children
    emit_class-->>get: doc.get(child_id)
    alt field.kind.as_str() == kind::code::FIELD
    emit_class-->>emit_class: writeln!(out, ' +{}', text(&field.name))
    end
    emit_class-->>get: doc.get(child_id)
    alt variant.kind.as_str() == kind::code::VARIANT
    emit_class-->>emit_class: writeln!(out, ' {}', text(&variant.name))
    end
    emit_class-->>get: doc.get(child_id)
    alt method.kind.as_str() == kind::code::METHOD
    emit_class-->>emit_class: writeln!(out, ' +{}()', text(&method.name))
    end
    end
    end
    emit_class-->>push_str: out.push_str(' }\n')
