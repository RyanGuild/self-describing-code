sequenceDiagram
    autonumber
    participant walk as walk()
    participant get as get
    participant push as push
    walk-->>get: self.nodes.get(id)
    alt let Some(node) = self.nodes.get(id)
    walk-->>push: out.push(node)
    loop &node.children
    walk-->>walk: self.walk(child, out)
    end
    end
