sequenceDiagram
    autonumber
    participant kind_tag as kind_tag()
    alt match kind.as_str()
    kind_tag-->>kind_tag: 'crate'
    else kind::code::MODULE
    kind_tag-->>kind_tag: 'mod'
    else kind::code::FILE
    kind_tag-->>kind_tag: 'file'
    else kind::code::STRUCT
    kind_tag-->>kind_tag: 'struct'
    else kind::code::ENUM
    kind_tag-->>kind_tag: 'enum'
    else kind::code::UNION
    kind_tag-->>kind_tag: 'union'
    else kind::code::TRAIT
    kind_tag-->>kind_tag: 'trait'
    else kind::code::IMPL
    kind_tag-->>kind_tag: 'impl'
    else kind::code::FUNCTION | kind::code::METHOD
    kind_tag-->>kind_tag: 'fn'
    else kind::code::CONST
    kind_tag-->>kind_tag: 'const'
    else kind::code::STATIC
    kind_tag-->>kind_tag: 'static'
    else kind::code::TYPE_ALIAS
    kind_tag-->>kind_tag: 'type'
    else kind::code::MACRO
    kind_tag-->>kind_tag: 'macro'
    else kind::code::FIELD
    kind_tag-->>kind_tag: 'field'
    else kind::code::VARIANT
    kind_tag-->>kind_tag: 'variant'
    else kind::code::IMPORT
    kind_tag-->>kind_tag: 'use'
    else kind::code::EXTERN_CRATE | kind::code::FOREIGN_MOD
    kind_tag-->>kind_tag: 'extern'
    else kind::code::TRAIT_ALIAS
    kind_tag-->>kind_tag: 'trait'
    else kind::code::VERBATIM
    kind_tag-->>kind_tag: 'item'
    else _
    kind_tag-->>kind_tag: 'node'
    end
