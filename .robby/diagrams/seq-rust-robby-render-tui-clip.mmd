sequenceDiagram
    autonumber
    participant clip as clip()
    participant to_owned as to_owned
    participant String__new as String::new
    participant saturating_sub as saturating_sub
    participant unwrap_or as unwrap_or
    participant push as push
    alt UnicodeWidthStr::width(text) <= max
    clip-->>to_owned: text.to_owned()
    clip-->>clip: return
    end
    clip-->>String__new: String::new()
    clip-->>clip: 0
    clip-->>saturating_sub: max.saturating_sub(1)
    loop text.chars()
    clip-->>unwrap_or: UnicodeWidthChar::width(ch).unwrap_or(0)
    alt width + char_width > budget
    clip-->>clip: break
    end
    clip-->>push: out.push(ch)
    clip-->>clip: width += char_width
    end
    clip-->>push: out.push('…')
    clip-->>clip: out
