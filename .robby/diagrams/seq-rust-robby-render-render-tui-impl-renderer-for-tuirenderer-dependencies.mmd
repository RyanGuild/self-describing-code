    dependencies-->>insert: index_of.insert(external.stable_id.clone(), index)
    dependencies-->>push: labels.push(format!('{} (ext)', external.label))
    end
    end
    alt labels.is_empty()
    dependencies-->>String__from: String::from('(no module dependencies)\n')
    dependencies-->>dependencies: return
