    dependencies-->>Graph__new: Graph::new()
    loop labels.iter().enumerate()
    dependencies-->>add_node: graph.add_node(index, label.as_str())
    end
    loop &view.edges
    dependencies-->>get: index_of.get(&edge.from)
    dependencies-->>get: index_of.get(&edge.to)
